# =============================== SEARCH =================================

# usage: search_text "start()" /home
function search_text () {
  if [ -z "$1" ]; then echo 'usage: search_text "start()" /home' >&2; return 1; fi
  sudo grep -E --color -rnI --exclude-dir={.git,node_modules} -- "$1" "${2:-.}"
}

# usage: search_text_files "start()" /home
function search_text_files () {
  if [ -z "$1" ]; then echo 'usage: search_text_files "start()" /home' >&2; return 1; fi
  sudo grep -E --color -rlI --exclude-dir={.git,node_modules} -- "$1" "${2:-.}"
}

# usage: search_text_by_extension "start()" php /home
function search_text_by_extension () {
  if [ -z "$1" ] || [ -z "$2" ]; then echo 'usage: search_text_by_extension "start()" php /home' >&2; return 1; fi
  sudo grep -E --color -rnI --include="*.$2" --exclude-dir={.git,node_modules} -- "$1" "${3:-.}"
}

# usage: search_file "index.php" /home
function search_file () {
  if [ -z "$1" ]; then echo 'usage: search_file "index.php" /home' >&2; return 1; fi
  sudo find -- "${2:-.}" -name "$1"
}

# ================================= GIT ==================================

function commit () {
  git commit -am "$1"
}

function push () {
  git push
}

function cush () {
  git commit -am "$1" && git push
}

function acpe () {
  local message="${1:-Improvements}"
  git add -A && git commit -am "$message" && git push || return 1
  exit
}

function ace () {
  git add -A && git commit -am "$1" || return 1
  exit
}

function pull () {
  git pull
}

function diff () {
  git diff
}

function status () {
  git status
}

function add () {
  git add -A
}

function git_reset_branch () {
  git reset --hard "origin/$1"
}

# ============================== UTILITIES ===============================

function watchme () {
  if [ -d functions ]; then cd functions || return 1; fi
  npm run check && npm run build:watch
}

function npm_test_by_name () {
  if [ -z "$1" ]; then echo 'usage: npm_test_by_name "test name"' >&2; return 1; fi
  npm test -- -t "$1"
}

function npm_test_full () {
  npm test -- --maxWorkers=50%
}

function base64_encode () {
  node -pe "Buffer.from(process.argv[1], 'utf8').toString('base64')" "$1"
}

function spell_add() {
  (( $# )) || { echo "usage: spell-add <word>..." >&2; return 1; }
  { printf '*%s\n' "$@"; echo '#'; } | aspell -a --lang=en_GB >/dev/null
}

# Node's base64 decoder accepts the base64url alphabet too, so both forms work.
# A "prefix_" is stripped only as a fallback, never up front: "_" is a real
# base64url character, and stripping eagerly silently eats payload:
# aGVsbG8_d29ybGQ= is "hello?world", not "world". A prefix left in place decodes
# to invalid UTF-8 instead, which is what the U+FFFD test detects.
function base64_decode () {
  node -pe '
    const input = process.argv[1];

    // Buffer.from is lenient where the old atob was strict: it drops characters
    // outside the alphabet rather than failing, so a mistyped or wrong-format
    // argument would decode to silent garbage. Whitespace stays allowed because
    // pasted base64 is often wrapped, and no length check because base64url is
    // routinely unpadded.
    if (!/^[A-Za-z0-9+/_=\s-]*$/.test(input)) {
      console.error("not base64: " + input);
      process.exit(1);
    }

    const decode = (s) => Buffer.from(s, "base64").toString("utf8");
    const full = decode(input);
    full.includes("\uFFFD") && input.includes("_")
      ? decode(input.slice(input.indexOf("_") + 1))
      : full;
  ' "$1"
}

function timestamp () {
  if [ -z "$1" ]; then echo 'usage: timestamp "2026-08-11T10:00:00Z"' >&2; return 1; fi

  local out
  out=$(node -pe "new Date(isNaN(process.argv[1]) ? process.argv[1] : +process.argv[1])" "$1") || return 1
  echo "$out"
  printf '%s' "$out" | xclip -selection clipboard >/dev/null 2>&1
}

function update_agents () (
  set -euo pipefail

  claude update
  codex update
  agy update

  echo ""
  echo "All agents updates."
)

function update_all () (
  set -o pipefail
  local failed=0

  _run_update () {
    local name="$1"
    shift
    printf '%s Updating...' "$name"
    local output
    if output="$("$@" 2>&1)"; then
      printf '\r\033[K%s \033[32mOK\033[0m\n' "$name"
    else
      printf '\r\033[K%s \033[31mFAILED\033[0m\n' "$name"
      [ -n "$output" ] && printf '\033[31m%s\033[0m\n' "$output" >&2
      failed=1
    fi
  }

  _run_update "Claude:    " update_claude
  _run_update "Codex:     " update_codex
  _run_update "Agy:       " update_agy

  _run_update "npm:       " update_npm
  _run_update "nvm:       " update_nvm
  _run_update "Firebase:  " update_firebase
  _run_update "Flutter:   " update_flutter

  return "$failed"
)

# =============================== COMMANDS ===============================

alias ..="cd .."
alias ls="ls -la"
alias rm="rm -i"
alias swap_clear="sudo swapoff -a && sudo swapon -a"
alias flutter_clean_pub_cache="dart pub cache gc"

# ============================== UPDATERS ================================

function update_claude () {
  claude update "$@"
}

function update_codex () {
  codex update "$@"
}

function update_agy () {
  agy update "$@"
}

function update_firebase () {
  npm install -g firebase-tools@latest "$@"
}

function update_npm () {
  npm install -g npm@latest "$@"
}

function update_flutter () {
  flutter upgrade --force "$@"
}

# PROFILE=/dev/null stops the installer appending its own nvm block to ~/.bashrc:
# it only looks there, so it can't see the copy this file already has.
function update_nvm () {
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | PROFILE=/dev/null bash
}

function update_ai_settings () {
  curl -fsSL https://raw.githubusercontent.com/vndly/ai-settings/main/install.sh | bash
}

function update_vscode_settings () {
  curl -fsSL https://raw.githubusercontent.com/vndly/vscode-settings/main/install.sh | bash
}

function update_bashrc_settings () {
  curl -fsSL https://raw.githubusercontent.com/vndly/bashrc-settings/main/install.sh | bash
}

# =============================== EXPORTS ================================

export VISUAL=vim
export EDITOR=vim

export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
export FLUTTER_HOME="/opt/Flutter/bin"
export FLUTTER_PUB_HOME="$HOME/.pub-cache/bin"
export ANDROID_HOME="/opt/AndroidSdk"
export ANDROID_STUDIO_HOME="/opt/AndroidStudio"
# Newest fully installed NDK, so an SDK upgrade never leaves a stale version pinned.
# A stale value is worse than none: Flutter takes the variable when set and skips
# its own NDK lookup. Partial installs have no source.properties and are ignored.
ANDROID_NDK_ROOT="$(find "$ANDROID_HOME/ndk" -mindepth 2 -maxdepth 2 -name source.properties -printf '%h\n' 2>/dev/null | sort -V | tail -1)"

if [ -n "$ANDROID_NDK_ROOT" ]; then
  export ANDROID_NDK_ROOT
  export ANDROID_NDK_HOME="$ANDROID_NDK_ROOT"
else
  unset ANDROID_NDK_ROOT ANDROID_NDK_HOME
fi

# Appends to PATH only if the directory exists and is not already there
function path_add () {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

path_add "$FLUTTER_HOME"
path_add "$FLUTTER_PUB_HOME"
path_add "$ANDROID_HOME/platform-tools"
path_add "$ANDROID_HOME/cmdline-tools/latest/bin"
path_add "$ANDROID_HOME/emulator"
export PATH

# ================================= NVM ==================================

export NVM_DIR="$HOME/.nvm"

# --no-use skips the "nvm use default" that nvm.sh runs on load, which is ~180ms
# of this file's ~200ms. Nothing else changes: the nvm function is defined as
# usual, so nvm use/install/ls all work. nvm_use_default below does the one part
# that was skipped, putting the default version on PATH.
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Puts nvm's default version on PATH without paying for nvm's own resolver, by
# reading the alias files directly. Returns non-zero when the default can't be
# resolved that way, so the caller can fall back to a real nvm use: an
# unresolved default must never silently leave PATH on the system node.
function nvm_use_default () {
  # A nested interactive shell inherits an active version through PATH, and nvm
  # keeps that version on load rather than reverting to the default, so this
  # does too. Overriding it would also strand the inherited bin directory
  # further down PATH.
  case ":$PATH:" in
    *":$NVM_DIR/versions/node/"*"/bin:"*) return 0 ;;
  esac

  local target depth=0

  [ -f "$NVM_DIR/alias/default" ] || return 1
  target="$(cat "$NVM_DIR/alias/default")" || return 1
  [ -n "$target" ] || return 1

  # An alias can point at another alias (default -> lts/* -> lts/jod -> v22.11.0).
  # "lts/*" is a real file named "*", hence the quoting on every lookup. -f, not
  # -r, because an empty target would otherwise test the alias directory itself
  # and cat it. The depth cap stops a cyclic alias from looping forever.
  while [ -f "$NVM_DIR/alias/$target" ] && [ "$depth" -lt 10 ]; do
    target="$(cat "$NVM_DIR/alias/$target")"
    depth=$((depth + 1))
  done

  # A partial version matches on whole components only: "24" is v24.18.0 or
  # v24.13.0, never v2.4.0. Hence the exact directory plus a glob for the
  # versions that continue past it, and sort -V to take the newest of those.
  local dir candidates=()
  for dir in "$NVM_DIR/versions/node/v${target#v}" "$NVM_DIR/versions/node/v${target#v}".*; do
    [ -x "$dir/bin/node" ] && candidates+=("$dir")
  done
  [ "${#candidates[@]}" -gt 0 ] || return 1

  local bin
  bin="$(printf '%s\n' "${candidates[@]}" | sort -V | tail -1)/bin"

  # Prepended, not appended, because /usr/local/bin holds an unrelated node that
  # would otherwise win. NVM_BIN is what nvm use exports, set here for parity.
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) PATH="$bin:$PATH" ;;
  esac
  export PATH
  export NVM_BIN="$bin"
}

if command -v nvm >/dev/null 2>&1 && ! nvm_use_default; then
  # The default is something only nvm can resolve, such as the "node" or
  # "stable" alias, or there is no default at all and nvm.sh would have fallen
  # back to an .nvmrc. Correctness over the load time --no-use saved.
  nvm use --silent default >/dev/null 2>&1 || nvm use --silent >/dev/null 2>&1
fi